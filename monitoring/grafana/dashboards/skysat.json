{
  "uid": "skysat",
  "title": "SkySat – model in production",
  "tags": [
    "skysat"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Serving model version",
      "description": "Registry version of skysat-satisfaction@champion that answered the latest request",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model_version::int AS \"version\" FROM predictions ORDER BY created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Predictions",
      "description": "Requests to POST /predict in the selected time range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"predictions\" FROM predictions WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "With real answer",
      "description": "Share of predictions whose real answer arrived through POST /feedback",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * count(actual) / NULLIF(count(*), 0) AS \"labelled\" FROM predictions WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Accuracy",
      "description": "Correct predictions among those with a real answer (time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * avg((predicted = actual)::int) AS \"accuracy\" FROM predictions WHERE actual IS NOT NULL AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "ROC AUC",
      "description": "Computed in SQL from the ranks of the predicted probabilities (Mann-Whitney)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- average rank for tied probabilities (rank() alone gives ties the lowest rank and biases AUC)\nWITH l AS (SELECT actual, rank() OVER (ORDER BY probability) + (count(*) OVER (PARTITION BY probability) - 1) / 2.0 AS r FROM predictions WHERE actual IS NOT NULL AND $__timeFilter(created_at))\nSELECT (sum(r) FILTER (WHERE actual = 1) - count(*) FILTER (WHERE actual = 1) * (count(*) FILTER (WHERE actual = 1) + 1) / 2.0) / NULLIF(count(*) FILTER (WHERE actual = 1) * count(*) FILTER (WHERE actual = 0), 0) AS \"AUC\" FROM l"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per 30 s, by API copy",
      "description": "One line per API container: Nginx spreads the load round-robin",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '30s', 0), replica AS metric, count(*) AS value\nFROM predictions WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model latency inside the API",
      "description": "Time spent in the API per prediction (k6 measures the full round trip)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '30s', NULL),\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS \"p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS \"p95\"\nFROM predictions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Accuracy and ROC AUC over time",
      "description": "Drops when the winter-storm drift starts, recovers after retraining (step 7)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '30s', NULL), avg((predicted = actual)::int) AS \"accuracy\"\nFROM predictions WHERE actual IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH l AS (\n  SELECT $__timeGroup(created_at, '30s') AS time, actual,\n    rank() OVER (PARTITION BY $__timeGroup(created_at, '30s') ORDER BY probability)\n    + (count(*) OVER (PARTITION BY $__timeGroup(created_at, '30s'), probability) - 1) / 2.0 AS r\n  FROM predictions WHERE actual IS NOT NULL AND $__timeFilter(created_at))\nSELECT time, (sum(r) FILTER (WHERE actual = 1) - count(*) FILTER (WHERE actual = 1) * (count(*) FILTER (WHERE actual = 1) + 1) / 2.0) / NULLIF(count(*) FILTER (WHERE actual = 1) * count(*) FILTER (WHERE actual = 0), 0) AS \"ROC AUC\" FROM l GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0.8,
          "max": 1,
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Satisfied passengers: predicted vs real",
      "description": "Share of passengers predicted satisfied, and the real share from feedback",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '30s', NULL), avg(predicted) AS \"predicted\", avg(actual) AS \"real\"\nFROM predictions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Model version serving",
      "description": "Steps up when a retrained model becomes champion and the API copies reload it",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skysat-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skysat-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '30s', NULL), max(model_version::int) AS \"version\"\nFROM predictions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 60000,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}