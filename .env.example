# Copy to .env and adjust if needed (.env is gitignored).
# MLflow. Leave these unset to use the local MLflow from `docker compose up` (http://localhost:5050).
# Set them to use the team's shared MLflow on DagsHub: the API loads the adapter skysat-reviews@champion from it.
# (make llm-train / llm-eval / llm-cycle ignore these and use a local sqlite MLflow unless you pass SHARED=yes.)
# MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo>.mlflow
# MLFLOW_TRACKING_USERNAME=<your DagsHub username>
# MLFLOW_TRACKING_PASSWORD=<your DagsHub token>
# MODEL_RELOAD_SECONDS=300   # how often the API asks for a new champion; be gentle with a hosted server

# Qwen is downloaded from Hugging Face (blocked on some networks: then use a local copy and HF_HUB_OFFLINE=1)
# HF_HUB_OFFLINE=1
# LLM_DTYPE=bfloat16   # or float32 (twice the RAM)

# PostgreSQL prediction log (table llm_scores); the same password is used by the API and Grafana
POSTGRES_PASSWORD=skysat
DATABASE_URL=postgresql://skysat:skysat@localhost:5432/skysat
