# Copy to .env and adjust if needed (.env is gitignored).
# MLflow server started with `docker compose up mlflow`
MLFLOW_TRACKING_URI=http://localhost:5050

# Where the API image gets PyTorch from. Leave unset for the small CPU-only build (works on Linux and Mac).
# On your own machine you can pick another wheel source, e.g. plain PyPI (the CUDA build, ~2 GB larger):
# TORCH_INDEX=https://pypi.org/simple
# The API always predicts on the CPU (training/train.py load_bundle), so the GPU build does not make serving faster.

# PostgreSQL prediction log (step 6); the same password is used by the API and Grafana
POSTGRES_PASSWORD=skysat
DATABASE_URL=postgresql://skysat:skysat@localhost:5432/skysat
